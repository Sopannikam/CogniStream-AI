# Save a copy as .env in the project root. Spring Boot and Docker read it.
# Do not wrap values in quotes: this file is also read as Java properties.
DB_USER=cognistream_user
DB_PASSWORD=local-development-only
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/cognistream_db
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
# Replace these encryption values with private random values before signing in.
# Keep them stable; changing them makes existing encrypted tokens unreadable.
TOKEN_ENCRYPTOR_PASSWORD=replace-with-a-long-random-password
TOKEN_ENCRYPTOR_SALT=0123456789abcdef
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
